# ==============================================================================
# JARVIS AI ASSISTANT — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' in jarvis/backend or project root and fill in your keys.
# ==============================================================================

# --- Server & Host Settings ---
PORT=8000
HOST=0.0.0.0
JARVIS_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,*

# --- WebSocket Security (Optional) ---
JARVIS_WS_AUTH_TOKEN=

# --- 3-Tier Persistent Memory Configuration ---
MONGODB_URI=
DATABASE_URL=
JARVIS_DB_PATH=jarvis_memory.db

# --- LLM Provider API Keys ---
# NVIDIA NIM API Key (Default) - Get key at: https://build.nvidia.com
NVIDIA_API_KEY=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

# Groq API Key
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Ollama Local LLM Base URL
OLLAMA_BASE_URL=http://localhost:11434

# --- Default Provider & Model Selection ---
DEFAULT_LLM_PROVIDER=NVIDIA
DEFAULT_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
